# Copy this file to .env and fill in what you need. Everything is optional:
# with no settings the project runs fully offline (TF-IDF retrieval + extractive answers).

# --- Generator: auto | extractive | anthropic | openai | ollama
UNIASSIST_GENERATOR=auto
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# UNIASSIST_MODEL=claude-sonnet-5-5      # or gpt-4o-mini, llama3.2 (ollama)

# --- Embedder: tfidf (default, offline) | minilm (needs sentence-transformers)
UNIASSIST_EMBEDDER=tfidf

# --- Refusal thresholds (override only after checking the evaluation report)
# UNIASSIST_MIN_SCORE=0.12
# UNIASSIST_MIN_OVERLAP=0.40
